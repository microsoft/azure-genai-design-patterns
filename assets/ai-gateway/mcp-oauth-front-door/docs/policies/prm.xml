<policies>
    <inbound>
        <base />
        <cors allow-credentials="false">
            <allowed-origins>
                <origin>*</origin>
            </allowed-origins>
            <allowed-methods>
                <method>GET</method>
                <method>OPTIONS</method>
            </allowed-methods>
            <allowed-headers>
                <header>*</header>
            </allowed-headers>
        </cors>
        <set-variable name="prmPath" value="@(context.Request.MatchedParameters.GetValueOrDefault("path", "").Trim('/').ToLowerInvariant())" />
        <set-variable name="prmKnown" value="@(Array.IndexOf("{{mcp-known-resource-paths}}".Split(';'), (string)context.Variables["prmPath"]) >= 0)" />
        <choose>
            <when condition="@((bool)context.Variables["prmKnown"])">
                <return-response>
                    <set-status code="200" reason="OK" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-header name="Cache-Control" exists-action="override">
                        <value>public, max-age={{mcp-metadata-max-age}}</value>
                    </set-header>
                    <set-header name="Access-Control-Allow-Origin" exists-action="override">
                        <value>*</value>
                    </set-header>
                    <set-body>@{
                        var path = (string)context.Variables["prmPath"];
                        var doc = new JObject(
                            new JProperty("resource", "{{mcp-gateway-base-url}}/" + path),
                            new JProperty("authorization_servers", new JArray("{{mcp-facade-issuer}}")),
                            new JProperty("scopes_supported", new JArray("mcp.tools")),
                            new JProperty("bearer_methods_supported", new JArray("header")),
                            new JProperty("resource_documentation", "{{mcp-docs-base-url}}/" + path.Split('/')[0])
                        );
                        return doc.ToString();
                    }</set-body>
                </return-response>
            </when>
            <otherwise>
                <return-response>
                    <set-status code="404" reason="Not Found" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-header name="Access-Control-Allow-Origin" exists-action="override">
                        <value>*</value>
                    </set-header>
                    <set-body>{"error":"not_found"}</set-body>
                </return-response>
            </otherwise>
        </choose>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
