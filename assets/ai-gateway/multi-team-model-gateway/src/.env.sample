# Copy to src/.env and fill in from the deployment outputs (teams[].projectEndpoint and
# teams[].connectionName). This file holds endpoints and names only. Gateway keys are
# read at run time from each team's Foundry project connection; never add one here.

TEAM_ALPHA_PROJECT_ENDPOINT=https://aif-contoso.services.ai.azure.com/api/projects/team-alpha
TEAM_ALPHA_CONNECTION=ai-gateway-team-alpha

TEAM_BETA_PROJECT_ENDPOINT=https://aif-contoso.services.ai.azure.com/api/projects/team-beta
TEAM_BETA_CONNECTION=ai-gateway-team-beta

# Shared deployment exposed through the gateway, and the Azure OpenAI API version clients use.
MODEL_DEPLOYMENT=chat
OPENAI_API_VERSION=2024-10-21
