// Shared foundation for MCP tool servers: everything an application revision
// assumes already exists.
//
// This template is deliberately separate from `private-mcp-server.bicep`:
//
//   * Lifecycle. A registry, a vault, and a log workspace outlive any revision
//     of an application. Redeploying (or `--mode Complete` deploying) an app
//     template must not be able to delete shared state. Separate templates make
//     that structural rather than a convention.
//
//   * Deterministic hostnames. The Container Apps *environment* owns the DNS
//     suffix (`defaultDomain`); an app only contributes its name. Creating the
//     environment here lets the app template compute `<app>.<defaultDomain>`
//     and set its DNS-rebinding allow-list (`ALLOWED_HOSTS`) correctly on the
//     first deployment. A server deployed with the wrong host allow-list does
//     not fail loudly; it returns HTTP 421, which looks like a networking
//     problem and hides the real cause.
//
// No secret is passed as a parameter. The only secret, the Application Insights
// connection string, is generated by Azure and written straight into Key Vault.

targetScope = 'resourceGroup'

@description('Deployment region.')
param location string = resourceGroup().location

@description('Short workload prefix used to derive resource names, for example "contoso".')
@minLength(3)
@maxLength(12)
param name string

@description('Optional object id of a human operator who may read and rewrite vault secrets. Leave empty in CI.')
param operatorObjectId string = ''

@description('Log retention in days.')
@minValue(30)
@maxValue(730)
param retentionDays int = 30

@description('Stage 2 (private) profile: inject the Container Apps environment into an existing subnet, make it internal-only, and reach Key Vault and ACR through private endpoints.')
param secureNetworking bool = false

@description('Resource id of the delegated (Microsoft.App/environments) subnet for the internal MCP Container Apps environment. Required when secureNetworking is true.')
param containerAppsSubnetId string = ''

@description('Resource id of the private endpoint subnet. Required when secureNetworking is true.')
param privateEndpointSubnetId string = ''

@description('Resource id of the virtual network that must resolve the private zones created here. Required when secureNetworking is true.')
param virtualNetworkId string = ''

@description('Set true only when the Key Vault private DNS zone already exists in this resource group (for example, created by another template).')
param useExistingKeyVaultZone bool = false

@description('Enable soft-delete purge protection. Recommended for production; cannot be turned off once enabled.')
param enablePurgeProtection bool = true

param tags object = {}

var registryName = '${toLower(replace(name, '-', ''))}acr${uniqueString(resourceGroup().id)}'
var keyVaultName = take(toLower('${name}-kv-${uniqueString(resourceGroup().id)}'), 24)
var workspaceName = '${name}-logs'
var insightsName = '${name}-insights'
var environmentName = '${name}-mcp-env'
var keyVaultPrivateDnsZoneName = 'privatelink.vaultcore.azure.net'
var registryPrivateDnsZoneName = 'privatelink.azurecr.io'

var keyVaultSecretsOfficer = 'b86a8fe4-44ce-4948-aee5-eccb2c155cd7'

resource registry 'Microsoft.ContainerRegistry/registries@2023-11-01-preview' = {
  name: registryName
  location: location
  tags: tags
  sku: {
    // Private endpoints on ACR require Premium.
    name: secureNetworking ? 'Premium' : 'Basic'
  }
  properties: {
    // Images are pulled with the app's managed identity. An admin user is a
    // shared, unattributable password; leaving it on "for now" is how it stays on.
    adminUserEnabled: false
    publicNetworkAccess: secureNetworking ? 'Disabled' : 'Enabled'
    // No public developer-IP exception in the private profile: images are
    // pushed from the private operator runner.
    networkRuleBypassOptions: 'AzureServices'
  }
}

resource workspace 'Microsoft.OperationalInsights/workspaces@2023-09-01' = {
  name: workspaceName
  location: location
  tags: tags
  properties: {
    sku: {
      name: 'PerGB2018'
    }
    retentionInDays: retentionDays
  }
}

resource insights 'Microsoft.Insights/components@2020-02-02' = {
  name: insightsName
  location: location
  tags: tags
  kind: 'web'
  properties: {
    Application_Type: 'web'
    WorkspaceResourceId: workspace.id
  }
}

resource keyVault 'Microsoft.KeyVault/vaults@2023-07-01' = {
  name: keyVaultName
  location: location
  tags: tags
  properties: {
    tenantId: subscription().tenantId
    sku: {
      family: 'A'
      name: 'standard'
    }
    // RBAC instead of access policies: app templates add their own role
    // assignments without replacing a shared policy list.
    enableRbacAuthorization: true
    enableSoftDelete: true
    softDeleteRetentionInDays: 7
    enablePurgeProtection: enablePurgeProtection ? true : null
    publicNetworkAccess: secureNetworking ? 'Disabled' : 'Enabled'
    networkAcls: {
      bypass: 'AzureServices'
      defaultAction: secureNetworking ? 'Deny' : 'Allow'
    }
  }
}

// Written from the resource's own output so the value never appears in a
// parameter file, pipeline log, or shell history.
resource insightsSecret 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = {
  parent: keyVault
  name: 'appinsights-connection'
  properties: {
    value: insights.properties.ConnectionString
    contentType: 'Application Insights connection string'
  }
}

resource operatorAccess 'Microsoft.Authorization/roleAssignments@2022-04-01' = if (!empty(operatorObjectId)) {
  scope: keyVault
  name: guid(keyVault.id, operatorObjectId, keyVaultSecretsOfficer)
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', keyVaultSecretsOfficer)
    principalId: operatorObjectId
    principalType: 'User'
  }
}

// ---------------------------------------------------------------------------
// Stage 2 private profile: private endpoints and zones for Key Vault and ACR.
// ---------------------------------------------------------------------------

resource newKeyVaultZone 'Microsoft.Network/privateDnsZones@2024-06-01' = if (secureNetworking && !useExistingKeyVaultZone) {
  name: keyVaultPrivateDnsZoneName
  location: 'global'
  tags: tags
}

resource existingKeyVaultZone 'Microsoft.Network/privateDnsZones@2024-06-01' existing = if (secureNetworking && useExistingKeyVaultZone) {
  name: keyVaultPrivateDnsZoneName
}

resource keyVaultZoneLink 'Microsoft.Network/privateDnsZones/virtualNetworkLinks@2024-06-01' = if (secureNetworking && !useExistingKeyVaultZone) {
  parent: newKeyVaultZone
  name: '${name}-kv-link'
  location: 'global'
  properties: {
    registrationEnabled: false
    virtualNetwork: {
      id: virtualNetworkId
    }
  }
}

resource keyVaultPrivateEndpoint 'Microsoft.Network/privateEndpoints@2024-05-01' = if (secureNetworking) {
  name: '${name}-kv-pe'
  location: location
  tags: tags
  properties: {
    subnet: {
      id: privateEndpointSubnetId
    }
    privateLinkServiceConnections: [
      {
        name: 'key-vault'
        properties: {
          privateLinkServiceId: keyVault.id
          groupIds: [
            'vault'
          ]
        }
      }
    ]
  }
}

resource keyVaultDnsGroup 'Microsoft.Network/privateEndpoints/privateDnsZoneGroups@2024-05-01' = if (secureNetworking) {
  parent: keyVaultPrivateEndpoint
  name: 'default'
  properties: {
    privateDnsZoneConfigs: [
      {
        name: 'key-vault'
        properties: {
          privateDnsZoneId: useExistingKeyVaultZone ? existingKeyVaultZone.id : newKeyVaultZone.id
        }
      }
    ]
  }
}

resource registryZone 'Microsoft.Network/privateDnsZones@2024-06-01' = if (secureNetworking) {
  name: registryPrivateDnsZoneName
  location: 'global'
  tags: tags
}

resource registryZoneLink 'Microsoft.Network/privateDnsZones/virtualNetworkLinks@2024-06-01' = if (secureNetworking) {
  parent: registryZone
  name: '${name}-acr-link'
  location: 'global'
  properties: {
    registrationEnabled: false
    virtualNetwork: {
      id: virtualNetworkId
    }
  }
}

resource registryPrivateEndpoint 'Microsoft.Network/privateEndpoints@2024-05-01' = if (secureNetworking) {
  name: '${name}-acr-pe'
  location: location
  tags: tags
  properties: {
    subnet: {
      id: privateEndpointSubnetId
    }
    privateLinkServiceConnections: [
      {
        name: 'registry'
        properties: {
          privateLinkServiceId: registry.id
          groupIds: [
            'registry'
          ]
        }
      }
    ]
  }
}

resource registryDnsGroup 'Microsoft.Network/privateEndpoints/privateDnsZoneGroups@2024-05-01' = if (secureNetworking) {
  parent: registryPrivateEndpoint
  name: 'default'
  properties: {
    privateDnsZoneConfigs: [
      {
        name: 'registry'
        properties: {
          privateDnsZoneId: registryZone.id
        }
      }
    ]
  }
}

// ---------------------------------------------------------------------------
// Container Apps environment. In the private profile it is internal-only and
// its generated default domain is published through a private DNS zone with a
// wildcard record pointing at the environment's static (internal) IP.
// ---------------------------------------------------------------------------

resource environment 'Microsoft.App/managedEnvironments@2024-03-01' = {
  name: environmentName
  location: location
  tags: tags
  properties: union({
    appLogsConfiguration: {
      destination: 'log-analytics'
      logAnalyticsConfiguration: {
        customerId: workspace.properties.customerId
        sharedKey: workspace.listKeys().primarySharedKey
      }
    }
    workloadProfiles: [
      {
        name: 'Consumption'
        workloadProfileType: 'Consumption'
      }
    ]
  }, secureNetworking ? {
    vnetConfiguration: {
      infrastructureSubnetId: containerAppsSubnetId
      internal: true
    }
  } : {})
}

module environmentDns 'modules/environment-dns.bicep' = if (secureNetworking) {
  name: '${name}-aca-dns'
  params: {
    zoneName: environment.properties.defaultDomain
    staticIp: environment.properties.staticIp
    virtualNetworkId: virtualNetworkId
    linkName: '${name}-aca-link'
    tags: tags
  }
}

output registryName string = registry.name
output registryServer string = registry.properties.loginServer
output keyVaultName string = keyVault.name
output appInsightsConnectionSecretUri string = insightsSecret.properties.secretUri
output logAnalyticsWorkspaceId string = workspace.id
output environmentId string = environment.id

// The reason this template exists in this shape: app templates can name
// themselves correctly on the first deployment.
output environmentDefaultDomain string = environment.properties.defaultDomain
output environmentStaticIp string = environment.properties.staticIp

// Zone names the operator network must also link to resolve these endpoints.
output privateDnsZoneNames array = secureNetworking
  ? [
      keyVaultPrivateDnsZoneName
      registryPrivateDnsZoneName
      environment.properties.defaultDomain
    ]
  : []
