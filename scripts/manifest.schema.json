{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/microsoft/agenticai-design-patterns/scripts/manifest.schema.json",
  "title": "Asset manifest",
  "description": "Metadata for one asset in assets/<category>/<id>/manifest.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "category", "title", "summary", "kind", "maturity", "version", "tags", "owners", "last_reviewed"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "description": "Stable asset id. Must equal the asset folder name.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "category": {
      "description": "Architectural category folder under assets/<category>/<id>/.",
      "type": "string",
      "enum": [
        "delivery-and-ops",
        "m365-and-copilot",
        "security-and-governance",
        "landing-zones-and-infra",
        "orchestration-and-workflows",
        "data-and-tools"
      ]
    },
    "title": { "type": "string", "minLength": 5, "maxLength": 100 },
    "summary": {
      "description": "One or two sentences: what the asset is and the problem it solves.",
      "type": "string",
      "minLength": 20,
      "maxLength": 500
    },
    "kind": {
      "type": "string",
      "enum": ["design-pattern", "reference-architecture", "solution-accelerator", "playbook", "sample"]
    },
    "maturity": {
      "type": "string",
      "enum": ["experimental", "preview", "stable", "deprecated"]
    },
    "version": {
      "description": "Semantic version of the asset.",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "azure_services": {
      "description": "Azure and Microsoft services the asset uses, by product name.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 60 }
    },
    "owners": {
      "description": "GitHub handles of the people who maintain the asset.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^@[A-Za-z0-9](?:[A-Za-z0-9_-]{0,38})$" }
    },
    "last_reviewed": {
      "description": "Date the content was last reviewed for accuracy (YYYY-MM-DD).",
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "related": {
      "description": "Ids of related assets in this repository.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "deprecated_by": {
      "description": "Id of the asset that replaces this one.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "pillars": {
      "description": "Path-to-production pillars this asset supports.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "coe-and-governance",
          "landing-zones",
          "agent-ops",
          "security-and-observability",
          "solution-optimization",
          "agent-architecture-patterns"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "maturity": { "const": "deprecated" } } },
      "else": { "not": { "required": ["deprecated_by"] } }
    }
  ]
}
